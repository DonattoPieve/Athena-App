{
  "name": "athena-app",
  "version": "1.0.30",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "description": "Cliente desktop do vault Athena — ingest, review, delete e publish sem terminal",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env ATHENA_DEV=1 electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test:md": "node scripts/md-roundtrip.mjs",
    "test:progresso": "node scripts/progresso.test.mjs",
    "test:worker": "node worker/teste.mjs",
    "test:espelho": "node scripts/espelho.test.mjs",
    "test:importar": "node scripts/importar.test.mjs",
    "test:guardas": "node scripts/guardas.test.mjs",
    "test:material": "node scripts/material.test.mjs",
    "test:pendencias": "node scripts/pendencias.test.mjs",
    "test:revisao": "node scripts/revisao.test.mjs",
    "test:sincronia": "node scripts/sincronia.test.mjs",
    "esqueleto:conferir": "node scripts/esqueleto.mjs",
    "esqueleto:sincronizar": "node scripts/esqueleto.mjs --sincronizar",
    "lancar": "node scripts/lancar.mjs",
    "telas": "node scripts/telas.mjs",
    "test": "npm run test:md && npm run test:progresso && npm run test:worker && npm run test:espelho && npm run test:importar && npm run test:guardas && npm run test:material && npm run test:pendencias && npm run test:revisao && npm run test:sincronia && npm run esqueleto:conferir",
    "worker:deploy": "npx --yes wrangler deploy --config worker/wrangler.jsonc",
    "dist": "npm run clean && npm run build && electron-builder --win --publish never",
    "dist:publish": "npm run clean && npm run build && electron-builder --win --publish always",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('release',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-code-block-lowlight": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-list": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extensions": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/suggestion": "^3.30.1",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.0.1",
    "lowlight": "^3.3.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "br.athena.app",
    "productName": "Athena",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/esqueleto/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DonattoPieve",
        "repo": "Athena-App",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "athena-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Athena",
      "runAfterFinish": true,
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Athena ${version}",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DonattoPieve/Athena-App.git"
  }
}
